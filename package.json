{
  "name": "eea-exam",
  "version": "0.1.0",
  "private": true,
  "description": "EEA Exam - assessment system with AI agent panel",
  "author": {
    "name": "alltobebetter",
    "email": "alltobebetter@outlook.com"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-assets.mjs",
    "start": "electron-vite preview",
    "server": "node server/index.mjs",
    "all": "node scripts/dev-both.mjs",
    "dist": "electron-vite build && node scripts/copy-assets.mjs && electron-builder --publish never",
    "icon": "python scripts/make-icon.py"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.35.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "potrace": "^2.1.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "cn.edu.xizang.eea-exam",
    "productName": "EEA Exam",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!server/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "shortcutName": "EEA Exam",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
